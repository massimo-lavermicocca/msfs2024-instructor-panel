@page "/"
@rendermode InteractiveServer


@using InstructorPanel.SimConnect

@inject ISimConnectService _simConnect;

<PageTitle>Home</PageTitle>
<form>
Position:
<div class="grid grid-cols-3">
    <div>
        <label for="latitude" class="form-label">Latitude</label>
        <input type="text" class="form-control" id="latitude" @bind="data.Latitude">
    </div>
     <div>
        <label for="longitude" class="form-label">Longitude</label>
        <input type="text" class="form-control" id="longitude" @bind="data.Longitude">
    </div>
    <div>
        <label for="altitude" class="form-label">Altitude</label>
        <input type="text" class="form-control" id="altitude" @bind="data.Altitude">
    </div
    <div>
        <label for="heading" class="form-label">Heading</label>
        <input type="text" class="form-control" id="heading" @bind="data.Heading">
    </div>
    <div>
        <label for="speed" class="form-label">Speed</label>
        <input type="text" class="form-control" id="speed" @bind="data.Speed">
    </div>
</div>

<button type="submit" class="btn" @onclick="Fly">Fly</button>
</form>

@code {

    public class InstructorData {
        public double Latitude { get; set; } = 41.05;
        public double Longitude { get; set; } = 16.4550;
        public uint Altitude { get; set; } = 3000;
        public int Heading { get; set; } = 65;
        public uint Speed { get; set; } = 200;
    }

    public InstructorData data { get; set; } = new();


    private async Task Fly()
    {
        _simConnect.SetIas(data.Speed);
            _simConnect.SetSpeed(data.Speed);

        while (true)
        {
            _simConnect.Teleport(data.Latitude, data.Longitude, data.Altitude);


            await Task.Delay(2000);

            _simConnect.SetHeading(data.Heading);
            _simConnect.SetPitch(3);
            
            _simConnect.SetRoll(0);
        }
        
    }
}