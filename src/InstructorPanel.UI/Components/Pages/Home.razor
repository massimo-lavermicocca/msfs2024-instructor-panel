@page "/"
@rendermode InteractiveServer

@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />

<PageTitle>Home</PageTitle>

Position:
<MudGrid>
    <MudItem xs="4">
         <MudAutocomplete T="string" Label="Waypoint"
               ValueChanged="OnWaypointSelected" SearchFunc="@SearchWaypoint" 
               AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary" />
    </MudItem>
    <MudItem xs="4">
        <MudTextField @bind-Value="Data.Latitude" Label="Latitude" Variant="Variant.Outlined"></MudTextField>
    </MudItem>
    <MudItem xs="4">
        <MudTextField @bind-Value="Data.Longitude" Label="Longitude" Variant="Variant.Outlined"></MudTextField>
    </MudItem>
    <MudItem xs="4">
        <MudTextField @bind-Value="Data.Altitude" Label="Altitude" Variant="Variant.Outlined"></MudTextField>
    </MudItem>
    <MudItem xs="4">
        <MudTextField @bind-Value="Data.Heading" Label="Heading" Variant="Variant.Outlined"></MudTextField>
    </MudItem>
    <MudItem xs="4">
        <MudTextField @bind-Value="Data.Speed" Label="Speed" Variant="Variant.Outlined"></MudTextField>
    </MudItem>
</MudGrid>
<br />

    @if (isPreparingAircraft == false)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" @onclick="StartPreparingAircraft">Prepare aircraft</MudButton>
    }
    else
    {
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" @onclick="StartPreparingAircraft">Stop</MudButton>
    }


